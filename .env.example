# Copia este archivo como .env para desarrollo local.
# En Cloudflare Pages, define la misma variable en Settings → Environment variables.

# Endpoint de tu formulario de Formspree (https://formspree.io → New form).
# Tiene la forma https://formspree.io/f/xxxxxxxx
PUBLIC_FORMSPREE_ENDPOINT=

# Id del proyecto de Microsoft Clarity (opcional). Vacío = sin Clarity y sin aviso de cookies.
# Está en https://clarity.microsoft.com → tu proyecto → Settings → Overview → Project ID.
PUBLIC_CLARITY_PROJECT_ID=
