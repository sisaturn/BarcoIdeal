---
/** Logotipo: vela estilizada + nombre del sitio. */
import { SITE_NAME } from '../config';

interface Props {
  /** 'oscuro' para fondos claros, 'claro' para fondos oscuros. */
  variante?: 'oscuro' | 'claro';
}
const { variante = 'oscuro' } = Astro.props;
const colorTexto = variante === 'claro' ? 'text-white' : 'text-mar-950';
---

<span class:list={['inline-flex items-center gap-2 text-lg font-extrabold tracking-tight', colorTexto]}>
  <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <circle cx="16" cy="16" r="16" fill="#1f4a77"></circle>
    <path d="M15 6 L15 21 L7.5 21 Z" fill="#ffffff"></path>
    <path d="M17 9 L17 21 L23.5 21 Z" fill="#fb8f5a"></path>
    <path d="M6 23.5 H26 L23.5 26.5 H8.5 Z" fill="#ffffff"></path>
  </svg>
  <span>{SITE_NAME}</span>
</span>
