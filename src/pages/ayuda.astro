---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormularioAyuda from '../islands/FormularioAyuda';
import { AYUDA } from '../data/textos';
import { CONTACT_EMAIL } from '../config';
---

<BaseLayout
  title="Ayuda personalizada para elegir barco"
  description="Cuéntame qué barco buscas, tu presupuesto y tu zona, y te envío 5 opciones de segunda mano en 48 horas, con sus pros, sus contras y su coste anual."
>
  <section class="bg-espuma-50 py-10 sm:py-14">
    <div class="contenedor grid items-start gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
      <div class="lg:sticky lg:top-24">
        <h1 class="text-3xl font-extrabold sm:text-4xl">{AYUDA.titulo}</h1>
        <p class="mt-4 text-lg leading-relaxed">{AYUDA.subtitulo}</p>
        {AYUDA.condiciones && <p class="mt-3 font-semibold text-mar-900">{AYUDA.condiciones}</p>}
        <h2 class="mt-8 text-lg font-bold">Qué vas a recibir</h2>
        <ul class="mt-3 space-y-2">
          {AYUDA.incluye.map((t) => (
            <li class="flex gap-2">
              <svg class="mt-1 size-4 shrink-0 text-mar-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                  clip-rule="evenodd"
                />
              </svg>
              <span>{t}</span>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-sm text-espuma-600">
          ¿Prefieres escribirme directamente?{' '}
          <a class="enlace" href={`mailto:${CONTACT_EMAIL}`}>
            {CONTACT_EMAIL}
          </a>
        </p>
      </div>

      <div>
        <FormularioAyuda client:load />
        <noscript>
          <p class="mt-4 rounded-xl border border-baliza-300 bg-baliza-50 p-4 text-baliza-800">
            El formulario necesita JavaScript. También puedes escribirme a {CONTACT_EMAIL}.
          </p>
        </noscript>
      </div>
    </div>
  </section>
</BaseLayout>
