---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CabeceraPagina from '../../components/CabeceraPagina.astro';
import Aviso from '../../components/Aviso.astro';
import Insignia from '../../components/Insignia.astro';
import FuenteDato from '../../components/FuenteDato.astro';
import { LISTA_TITULACIONES, AVISO_TITULACIONES, alcanceTitulacion } from '../../data/titulaciones';
import { barcosParaTitulacion } from '../../lib/fichas';
import { textoCosteCurso, textoEslora } from '../../lib/textoTitulacion';

const fuentes = LISTA_TITULACIONES.flatMap((t) => t.fuentes);
---

<BaseLayout
  title="Titulaciones náuticas de recreo en España"
  description="Licencia de Navegación, PNB, PER, Patrón de Yate y Capitán de Yate: eslora, distancia y horario que permite cada titulación según el Real Decreto 875/2014."
>
  <CabeceraPagina
    titulo="Titulaciones náuticas de recreo"
    antetitulo="Normativa"
    subtitulo="Qué permite cada titulación, según el Real Decreto 875/2014. De menos a más: cada una permite barcos más grandes y alejarse más de la costa."
    migas={[{ texto: 'Inicio', href: '/' }, { texto: 'Titulaciones' }]}
  />

  <section class="py-12 sm:py-16">
    <div class="contenedor">
      <Aviso titulo="Datos verificados" tono="info" class="mb-8">
        {AVISO_TITULACIONES}
      </Aviso>

      <ol class="relative space-y-4 before:absolute before:top-4 before:bottom-4 before:left-5 before:w-0.5 before:bg-mar-100">
        {LISTA_TITULACIONES.map((t) => {
          const barcos = barcosParaTitulacion(t.id);
          const curso = textoCosteCurso(t);
          return (
            <li class="relative pl-14">
              <span
                class="absolute top-5 left-0 flex size-10 items-center justify-center rounded-full bg-mar-700 text-sm font-extrabold text-white ring-4 ring-white"
                aria-hidden="true"
              >
                {t.nivel}
              </span>
              <a
                href={`/titulaciones/${t.slug}/`}
                class="tarjeta group block transition hover:-translate-y-0.5 hover:border-mar-300 hover:shadow-md"
              >
                <span class="flex flex-wrap items-baseline justify-between gap-2">
                  <span class="text-xl font-bold text-mar-950 group-hover:underline">{t.nombre}</span>
                  <span class="rounded-full bg-mar-100 px-3 py-0.5 text-sm font-semibold text-mar-900">
                    {textoEslora(t)}
                  </span>
                </span>
                <span class="mt-2 block">{alcanceTitulacion(t)}</span>
                {t.ampliacion && <span class="mt-1 block text-sm">{t.ampliacion.texto}</span>}
                {t.requisitos && <span class="mt-1 block text-sm text-espuma-600">Requisitos: {t.requisitos}</span>}
                {curso && (
                  <span class="mt-2 flex flex-wrap items-center gap-2 text-sm text-espuma-600">
                    Curso: {curso} <Insignia tipo="mercado" texto="Precio de mercado, no tasa oficial" />
                  </span>
                )}
                {barcos.length > 0 && (
                  <span class="mt-3 block text-sm">
                    <span class="font-semibold text-mar-950">Tipos de barco: </span>
                    {barcos
                      .map(
                        (b) =>
                          `${b.tipo.nombre.toLowerCase()}${b.alcance === 'pequenos' ? ' (solo los más pequeños)' : ''}`,
                      )
                      .join(', ')}
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ol>

      <FuenteDato fuentes={fuentes} class="mt-8" />

      <div class="mt-12 flex flex-col items-start gap-4 rounded-2xl bg-mar-950 p-6 text-white sm:flex-row sm:items-center sm:justify-between sm:p-8">
        <div>
          <h2 class="text-xl font-bold text-white">¿No sabes cuál necesitas?</h2>
          <p class="mt-1 text-mar-100">
            El test te recomienda barcos que encajan con la titulación que tienes o quieres sacarte.
          </p>
        </div>
        <a href="/test/" class="btn-primario shrink-0">
          Hacer el test
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
